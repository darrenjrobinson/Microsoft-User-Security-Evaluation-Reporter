# Copy to .env for local development (npm run dev loads it automatically).

# Serve canned demo data instead of calling Microsoft Graph / Have I Been Pwned
MOCK_GRAPH=true

# Skip the App Service Authentication check locally (refused when NODE_ENV=production)
AUTH_DISABLED=true

PORT=8080

# --- To call a real tenant locally, set MOCK_GRAPH=false and provide a dev app registration
# that has been granted the Graph application permissions listed in the README.
# DefaultAzureCredential picks these up (EnvironmentCredential).
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Have I Been Pwned v3 API key (https://haveibeenpwned.com/API/Key)
# HIBP_API_KEY=

# Optional tenant policy overlays (required-PIM roles, break-glass / service accounts, thresholds) as JSON.
# See "Optional: tune the tenant policy" in the README. Mock mode uses a demo policy when this is unset.
# POLICY_JSON={"breakGlassAccounts":["ea01@contoso.onmicrosoft.com"]}
